@page
@model UnlinkedAccountHoldingModel
@{
    ViewData["Title"] = "Cannot access provider service";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">You do not have access to any early years provider records</h1>
        
        <p class="govuk-body">
            Your DfE Sign-In account is authenticated, but it has not been linked to an early years provider in this service.
        </p>

        <govuk-inset-text>
            If you believe you should have access, contact your organization's DfE Sign-In approver or your local authority representative to request assignment.
        </govuk-inset-text>
    </div>
</div>