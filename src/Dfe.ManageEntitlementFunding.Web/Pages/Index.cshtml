@page
@model IndexModel
@{
    ViewData["Title"] = "Manage entitlement funding for early years providers";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Manage entitlement funding for early years providers</h1>

        <p class="govuk-body-l">
            Use this service to manage data and funding claims around statutory early years entitlements:
        </p>

        <ul class="govuk-list govuk-list--bullet">
            <li>Working families entitlements</li>
            <li>Universal 2-year-old entitlements</li>
            <li>3-year-old entitlements</li>
        </ul>

        <govuk-warning-text icon-fallback-text="Warning">
            You will need a DfE Sign-In account linked to an early years provider to access this service.
        </govuk-warning-text>

        <!-- GOV.UK Start Button pointing to protected route -->
        <a href="/Dashboard" role="button" draggable="false" class="govuk-button govuk-button--start" data-module="govuk-button">
            Start now
            <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
            </svg>
        </a>
    </div>
</div>