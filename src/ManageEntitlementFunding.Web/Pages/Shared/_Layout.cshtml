@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Manage entitlement funding for early years providers - GOV.UK</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit-no">

    <!-- GOV.UK Icons and Favicons -->
    <link rel="shortcut icon" sizes="16x16 32x32 48x48" href="~/assets/images/favicon.ico" type="image/x-icon">
    <link rel="mask-icon" href="~/assets/images/govuk-icon-mask.svg" color="#0b0c0c">
    <link rel="apple-touch-icon" sizes="180x180" href="~/assets/images/govuk-icon-180.png">
    <link rel="apple-touch-icon" sizes="167x167" href="~/assets/images/govuk-icon-167.png">
    <link rel="apple-touch-icon" sizes="152x152" href="~/assets/images/govuk-icon-152.png">
    <link rel="apple-touch-icon" href="~/assets/images/govuk-icon-180.png">
    
    <!-- GOV.UK Frontend Styles automatically mapped by UseGovUkFrontend() -->
    <link rel="stylesheet" href="~/govuk-frontend.min.css" />
</head>
<body class="govuk-template__body">
    <script>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>

    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>

    <!-- GOV.UK Header -->
    <govuk-header service-name="Manage entitlement funding for early years providers" service-url="/">
    </govuk-header>

    <div class="govuk-width-container">
        <!-- GOV.UK Phase Banner -->
        <govuk-phase-banner>
            <govuk-phase-banner-tag>Beta</govuk-phase-banner-tag>
            This is a new service – your <a class="govuk-link" href="#">feedback</a> will help us to improve it.
        </govuk-phase-banner>

        @* Render Dev User Status & Logout Button only in Development *@
@* Compact Dev Session Toolbar *@
        @if (Env.IsDevelopment() && User.Identity?.IsAuthenticated == true)
        {
            <div class="govuk-body-s govuk-!-margin-top-2 govuk-!-margin-bottom-4" style="background-color: #f3f2f1; padding: 6px 12px; border-left: 4px solid #1d70b8; display: flex; justify-content: space-between; align-items: center;">
                <span>
                    <strong>DEV SESSION:</strong> Signed in as <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</strong> (@User.FindFirst("sub")?.Value)
                </span>
                <form method="post" asp-page="/DevLogin" asp-page-handler="Logout" style="margin: 0;">
                    <button type="submit" class="govuk-link govuk-body-s" style="background: none; border: none; padding: 0; text-decoration: underline; cursor: pointer; color: #1d70b8;">
                        Dev Sign out
                    </button>
                </form>
            </div>
        }
        
        <main class="govuk-main-wrapper" id="main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <!-- GOV.UK Footer -->
    <govuk-footer>
    </govuk-footer>

    <!-- Progressive JavaScript Enhancement -->
    <script type="module" src="~/govuk-frontend.min.js"></script>
    <script type="module">
        import { initAll } from '/govuk-frontend.min.js'
        initAll()
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>