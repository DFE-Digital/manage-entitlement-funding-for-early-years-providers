{
  "name": "manage-entitlement-funding-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('../artifacts/docs', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "eleventy",
    "prestart": "npm run clean",
    "start": "eleventy --serve"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@x-govuk/govuk-eleventy-plugin": "^9.0.2"
  }
}
