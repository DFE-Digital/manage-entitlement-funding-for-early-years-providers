<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
            <Exclude>
                [ManageEntitlementFunding.Web]AspNetCoreGeneratedDocument.*
            </Exclude>
            <ExcludeByFile>
                **/Microsoft.AspNetCore.OpenApi.SourceGenerators/**/*.cs
            </ExcludeByFile>
        </Configuration> 
     </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>