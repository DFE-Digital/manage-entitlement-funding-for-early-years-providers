{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "just",
      "type": "process",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-app",
      "command": "just",
      "type": "process",
      "args": [
        "build-app"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}