{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Dfe.ManageEntitlementFunding.Api/bin/Debug/net10.0/Dfe.ManageEntitlementFunding.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Dfe.ManageEntitlementFunding.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Debug Web",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Dfe.ManageEntitlementFunding.Web/bin/Debug/net10.0/Dfe.ManageEntitlementFunding.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Dfe.ManageEntitlementFunding.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s*(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ApiBaseUrl": "https://localhost:7168"
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch Both (API + Web)",
      "configurations": [
        "Debug API",
        "Debug Web"
      ],
      "preLaunchTask": "build",
      "stopAll": true
    }
  ]
}